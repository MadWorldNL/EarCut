<Project>
    <PropertyGroup>
        <Company>Mad-World.nl</Company>
        <Copyright>Copyright (c) Mad-World.nl 2026</Copyright>
        <Authors>Oscar Veldman</Authors>
        <Product>EarCut</Product>
    </PropertyGroup>
    
    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- CA1873: LoggerMessage delegates are not required for this project. Use standard ILogger extension methods instead. -->
        <!-- NU1901: Package with known low-severity vulnerability. -->
        <!-- NU1902: Package with known moderate-severity vulnerability. -->
        <!-- NU1903: Package with known high-severity vulnerability. -->
        <NoWarn>$(NoWarn);CA1873;NU1901;NU1902;NU1903</NoWarn>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
</Project>